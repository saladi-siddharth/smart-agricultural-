{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/send-email", "destination": "/api/send-email.js" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/farms", "destination": "/farms.html" },
    { "source": "/crops", "destination": "/crops.html" },
    { "source": "/activities", "destination": "/activities.html" },
    { "source": "/soil", "destination": "/soil.html" },
    { "source": "/community", "destination": "/community.html" },
    { "source": "/worker", "destination": "/worker.html" },
    { "source": "/labour", "destination": "/labour.html" },
    { "source": "/alerts", "destination": "/alerts.html" },
    { "source": "/inputs", "destination": "/inputs.html" },
    { "source": "/expenses", "destination": "/expenses.html" },
    { "source": "/intelligence", "destination": "/intelligence.html" },
    { "source": "/reports", "destination": "/reports.html" },
    { "source": "/roles", "destination": "/roles.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/audit", "destination": "/audit.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
