# FarmPilot — Environment Variables
# Copy to .env to connect to your live Supabase project

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Public Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: If these variables are not set or left as placeholder,
# FarmPilot automatically activates Demo Mode with full local storage persistence
# for the Green Valley Farm (Machilipatnam, AP) reference model.
